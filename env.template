# =============================================================================
# Research OS - Environment Configuration Template
# =============================================================================
#
# This file contains ALL environment variables required by the application.
# Copy this file to .env and update the values for your environment.
#
# Usage:
#   cp env.template .env
#   # Edit .env with your actual values
#
# WARNING: Never commit .env files containing real secrets to version control!
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Core application identification and behavior settings.

# Application display name (used in API docs, logging, etc.)
APP_NAME=Research OS

# Semantic version of the application
APP_VERSION=0.1.0

# Runtime environment: development, staging, production
# Controls debug mode, logging levels, and feature flags
ENVIRONMENT=development

# Enable debug mode (verbose logging, stack traces, hot reload)
# Set to false in production for security and performance
DEBUG=true

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# FastAPI server network settings.

# Host address to bind the API server
# Use 0.0.0.0 for all interfaces, 127.0.0.1 for localhost only
API_HOST=0.0.0.0

# Port number for the API server
API_PORT=8000

# URL prefix for API v1 endpoints (versioning)
API_V1_PREFIX=/api/v1

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
# Async database connection for the application.
# Ensure the database exists before starting the application.

# Database server hostname
POSTGRES_HOST=localhost

# Database server port
POSTGRES_PORT=5432

# Database username with access to the application database
POSTGRES_USER=research_os

# Database password - CHANGE THIS IN PRODUCTION!
POSTGRES_PASSWORD=change_me_in_production

# Name of the application database
POSTGRES_DB=research_os

# =============================================================================
# REDIS CACHE & MESSAGE BROKER
# =============================================================================
# Redis server for caching, session storage, and Celery message broker.

# Redis server hostname
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis password (leave empty if Redis auth is disabled)
REDIS_PASSWORD=

# Redis database number (0-15, useful for separating concerns)
REDIS_DB=0

# =============================================================================
# CELERY TASK QUEUE
# =============================================================================
# Background task processing via Celery with Redis as broker/backend.

# Celery message broker URL (Redis connection string)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend for storing task results
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# OLLAMA LLM CONFIGURATION
# =============================================================================
# Local LLM server for AI-powered features.

# Base URL of the Ollama server (including protocol and port)
OLLAMA_BASE_URL=http://localhost:11434

# Model name to use for text generation
# Available models: qwen3, llama3, mistral, codellama, etc.
OLLAMA_MODEL=qwen3

# Request timeout in seconds for LLM calls
OLLAMA_TIMEOUT=120

# =============================================================================
# CHROMADB VECTOR STORE
# =============================================================================
# ChromaDB for semantic search and embeddings storage.

# Directory for persisting ChromaDB data
CHROMA_PERSIST_DIR=./chroma_data

# =============================================================================
# LANGSMITH OBSERVABILITY
# =============================================================================
# LangSmith for tracing, debugging, and monitoring LLM calls.
# Sign up at https://langsmith.ai to get an API key.

# Enable LangSmith tracing (true/false)
LANGSMITH_TRACING=false

# Your LangSmith API key (leave empty if tracing is disabled)
LANGSMITH_API_KEY=

# LangSmith project name for organizing traces
LANGSMITH_PROJECT=research-agent

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# Cryptographic keys and JWT configuration.
# IMPORTANT: Generate new keys for production using: python -c "import secrets; print(secrets.token_hex(32))"

# Flask/Django secret key for session signing and CSRF protection
SECRET_KEY=change_me_in_production

# JWT secret key for token signing and verification
JWT_SECRET_KEY=change_me_in_production

# JWT algorithm for token signing (HS256, HS384, RS256, etc.)
JWT_ALGORITHM=HS256

# JWT token expiration time in minutes
JWT_EXPIRATION_MINUTES=60

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Allowed origins for cross-origin requests.
# Separate multiple origins with commas. Use * for all (not recommended for production).

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173